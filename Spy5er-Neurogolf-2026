f fn(ig).shape!=og.shape or not np.array_equal(fn(ig),og): ok=False; break\n        if ok: return name\n    return None\n \ndef detect_transpose(pairs) -> bool:\n    for p in pairs:\n        ig=np.asarray(p[\"input\"]); og=np.asarray(p[\"output\"])\n        if ig.T.shape!=og.shape or not np.array_equal(ig.T,og): return False\n    return True\n \ndef detect_anti_transpose(pairs) -> bool:\n    for p in pairs:\n        ig=np.asarray(p[\"input\"]); og=np.asarray(p[\"output\"])\n        exp=np.flipud(np.fliplr(ig.T))\n        if exp.shape!=og.shape or not np.array_equal(exp,og): return False\n    return True\n \ndef detect_color_map(pairs):\n    if not all_same_io_shape(pairs): return None\n    mapping = {}\n    for p in pairs:\n        for a,b in zip(np.asarray(p[\"input\"]).flatten().tolist(),\n                       np.asarray(p[\"output\"]).flatten().tolist()):\n            a,b=int(a),int(b)\n            if a in mapping and mapping[a]!=b: return None\n            mapping[a]=b\n    if all(k==v for k,v in mapping.items()): return None\n    return mapping\n \ndef detect_color_filter(pairs):\n    if not all_same_io_shape(pairs): return None\n    candidate=None\n    for p in pairs:\n        ig=np.asarray(p[\"input\"]); og=np.asarray(p[\"output\"])\n        diff=(ig!=og)\n        if not np.any(diff): continue\n        if not np.all(og[diff]==0): return None\n        local=set(int(x) for x in ig[diff].tolist())\n        candidate=local if candidate is None else candidate|local\n    if not candidate: return None\n    for p in pairs:\n        ig=np.asarray(p[\"input\"]).copy()\n        for c_ in candidate: ig[ig==c_]=0\n        if not np.array_equal(ig,np.asarray(p[\"output\"])): return None\n    return candidate\n \ndef detect_fixed_crop(pairs):\n    if not pairs: return None\n    fst_in=np.asarray(pairs[0][\"input\"]); fst_out=np.asarray(pairs[0][\"output\"])\n    oh_,ow_=fst_out.shape; ih,iw=fst_in.shape\n    if oh_>ih or ow_>iw: return None\n    for r0 in range(ih-oh_+1):