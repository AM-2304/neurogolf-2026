es = {}\n    for vi in list(model.graph.input) + list(model.graph.output):\n        shapes[vi.name] = tuple(\n            d.dim_value if d.dim_value > 0 else 1\n            for d in vi.type.tensor_type.shape.dim\n        )\n    for init in model.graph.initializer:\n        shapes[init.name] = tuple(init.dims)\n    for node in model.graph.node:\n        if node.op_type == \"Constant\":\n            for attr in node.attribute:\n                if attr.name == \"value\":\n                    shapes[node.output[0]] = tuple(attr.t.dims) if attr.t.dims else ()\n    return shapes\n \n \ndef estimate_macs(model) -> int:\n    macs = 0\n    shapes = _shape_map(model)\n    for node in model.graph.node:\n        if node.op_type == \"Conv\":\n            w = shapes.get(node.input[1] if len(node.input) >= 2 else \"\")\n            if w and len(w) == 4:\n                out_c, in_c, kh, kw = w\n                macs += int(out_c * in_c * kh * kw * H * W)\n        elif node.op_type in (\"Gemm\", \"MatMul\"):\n            if len(node.input) >= 2:\n                a = shapes.get(node.input[0])\n                b = shapes.get(node.input[1])\n                if a and b and len(a) >= 2 and len(b) >= 2:\n                    macs += int(a[-1]) * int(b[-1]) * int(a[-2] if len(a) > 1 else 1)\n    return macs\n \n \ndef compute_cost(model) -> int:\n    return count_params(model) + len(model_bytes(model)) + estimate_macs(model)\n \n \ndef compute_score(cost_val) -> float:\n    return max(1.0, 25.0 - math.log(max(1, cost_val)))\n \n \ndef _fix_reduce_ops_opset17(model):\n    \"\"\"\n    torch.onnx.export(opset_version=17) in PyTorch 2.x emits ReduceMax/ReduceMean\n    with axes as a second INPUT (opset-18 semantics). The axes tensor can appear as\n    either a graph initializer OR the output of a Constant node — both are handled.\n    \"\"\"\n    # Build axes lookup from initializers\n    axes_from_init = {\n        init.name: onh.to_array(init).flatten().astype(int).tolist()\n        for init in model.graph.initializer\n    }\n    # Build axes lookup from Constant nodes\n    axes_from_const: Dict[str, list] = {}\n    for node in model.graph.node:\n        if node.op_type == \"Constant\" and node.output:\n            for attr in node.attribute:\n                if attr.name == \"value\":\n                    try:\n                        arr = onh.to_array(attr.t).flatten().astype(int).tolist()\n                        axes_from_const[node.output[0]] = arr\n                    except Exception:\n                        pass\n \n    # Identify which Constant node outputs are consumed as axes inputs\n    consumed_const_outputs: Set[str] = set()\n    inits_to_remove: Set[str] = set()\n    fixed_nodes = []\n \n    for node in model.graph.node:\n        if node.op_type in (\"ReduceMax\", \"ReduceMean\") and len(node.input) >= 2:\n            axes_input = node.input[1]\n            axes_list = None\n \n            if axes_input in axes_from_init:\n                axes_list = axes_from_init[axes_input]\n                inits_to_remove.add(axes_input)\n            elif axes_input in axes_from_const:\n                axes_list = axes_from_const[axes_input]\n                consumed_const_outputs.add(axes_input)\n \n            if axes_list is not None:\n                keepdims = next(\n                    (a.i for a in node.attribute if a.name == \"keepdims\"), 1\n                )\n                fixed_nodes.append(oh.make_node(\n                    node.op_type,\n                    [node.input[0]],\n                    list(node.output),\n                    axes=axes_list,\n                    keepdims=keepdims,\n                    # noop_with_empty_axes intentionally omitted — opset-18 only\n                ))\n                continue\n        fixed_nodes.append(node)\n \n    if not inits_to_remove and not consumed_const_outputs:\n        return model  # nothing changed\n \n    # Rebuild graph: exclude consumed Constant nodes and removed initializers\n    final_nodes = [\n        n for n in fixed_nodes\n        if not (n.op_type == \"Constant\" and n.output\n                and n.output[0] in consumed_const_outputs)\n    ]\n    del model.graph.node[:]\n    model.graph.node.extend(final_nodes)\n \n    kept_inits = [i for i in model.graph.initializer if i.name not in inits_to_remove]\n    del model.graph.initializer[:]\n    model.graph.initializer.extend(kept_inits)\n \n    return model\n \n \ndef check_all_shapes_static(model) -> bool:\n    \"\"\"\n    Competition rule: all tensors must have statically-defined shapes.\n    onnx.checker does NOT enforce this — this function does.\n    Every intermediate value_info must have a fully-resolved, positive shape.\n    \"\"\"\n    try:\n        inferred = onnx.shape_inference.infer_shapes(model)\n    except Exception:\n        return False\n \n    def _is_static(vi):\n        tt = vi.type.tensor_type\n        if not tt.HasField(\"shape\"):\n            return False\n        for dim in tt.shape.dim:\n            if dim.dim_param:           # symbolic dim (\"batch_size\" etc.) — dynamic\n                return False\n            if dim.dim_value <= 0:      # 0 or unknown int dim\n                return False\n        return True\n \n    for vi in inferred.graph.value_info:\n        if not _is_static(vi):\n            return False\n    for vi in list(inferred.graph.input) + list(inferred.graph.output):\n        if not _is_static(vi):\n            return False\n    return True\n \n \ndef check_model_correct(model, pairs) -> bool:\n    if not pairs:\n        return False\n    if not check_fits(model) or not check_ops_allowed(model):\n        return False\n \n    # Structural validity — must pass before ORT (ORT is lenient, Kaggle evaluator is not)\n    try:\n        onnx.checker.check_model(model)\n    except Exception:\n        return False\n \n    # Static-shape rule — Kaggle enforces this; onnx.checker does not\n    if not check_all_shapes_static(model):\n        return False\n \n    try:\n        so = ort.SessionOptions()\n        so.log_severity_level = 3\n        sess = ort.InferenceSession(\n            model_bytes(model), sess_options=so,\n            providers=[\"CPUExecutionProvider\"]\n        )\n    except Exception:\n        return False\n \n    try:\n        for p in pairs:\n            inp  = grid_to_tensor(p[\"input\"])\n            og   = np.asarray(p[\"output\"])\n            oh_, ow_ = og.shape\n            pred = sess.run(None, {\"input\": inp})[0]\n            outside = pred.copy()\n            outside[0, :, :oh_, :ow_] = 0.0\n            if np.max(np.abs(outside)) > 1e-4:\n                return False\n            if tensor_to_grid(pred, oh_, ow_) != p[\"output\"]:\n                return False\n        return True\n    except Exception:\n        return False","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-23T20:27:56.044378Z","iopub.execute_input":"2026-04-23T20:27:56.044680Z","iopub.status.idle":"2026-04-23T20:27:56.162761Z","shell.execute_reply.started":"2026-04-23T20:27:56.044659Z","shell.execute_reply":"2026-04-23T20:27:56.162072Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# Model Builders (Geometric + Analytic ONNX)","metadata":{}},{"cell_type":"code","source":"# --- Geometric Primitives ---\n \ndef _pad_to_canvas(in_name, out_name, out_h, out_w, suf=\"\"):\n    pads = np.asarray([0,0,0,0, 0,0,H-out_h,W-out_w], dtype=np.int64)\n    return [\n        _const(f\"pd{suf}\", pads),\n        oh.make_node(\"Pad\", [in_name, f\"pd{suf}\"], [out_name], mode=\"constant\"),\n    ]\n \ndef _crop_to_content(in_name, out_name, h, w, suf=\"\"):\n    return [\n        _const(f\"cs{suf}\", np.asarray([0,0], dtype=np.int64)),\n        _const(f\"ce{suf}\", np.asarray([h,w],  dtype=np.int64)),\n        _const(f\"ca{suf}\", np.asarray([2,3],  dtype=np.int64)),\n        oh.make_node(\"Slice\", [in_name, f\"cs{suf}\", f\"ce{suf}\", f\"ca{suf}\"], [out_name]),\n    ]\n \ndef _slice_reverse(axes, dims, in_name, out_name, suf=\"\"):\n    starts = [d-1 for d in dims]\n    ends   = [-d-1 for d in dims]\n    steps  = [-1]*len(dims)\n    return [\n        _const(f\"rs_s{suf}\", np.asarray(starts, dtype=np.int64)),\n        _const(f\"rs_e{suf}\", np.asarray(ends,   dtype=np.int64)),\n        _const(f\"rs_a{suf}\", np.asarray(axes,   dtype=np.int64)),\n        _const(f\"rs_p{suf}\", np.asarray(steps,  dtype=np.int64)),\n        oh.make_node(\"Slice\",\n                     [in_name, f\"rs_s{suf}\", f\"rs_e{suf}\", f\"rs_a{suf}\", f\"rs_p{suf}\"],\n                     [out_name]),\n    ]\n \ndef make_identity():\n    return _make_model([oh.make_node(\"Identity\", [\"input\"], [\"output\"])], \"identity\")\n \ndef make_transpose_hw():\n    return _make_model(\n        [oh.make_node(\"Transpose\", [\"input\"], [\"output\"], perm=[0,1,3,2])], \"transpose_hw\")\n \ndef make_flip_h():\n    return _make_model(_slice_reverse([2],[H],\"input\",\"output\"), \"flip_h\")\n \ndef make_flip_w():\n    return _make_model(_slice_reverse([3],[W],\"input\",\"output\"), \"flip_w\")\n \ndef make_flip_both():\n    return _make_model(_slice_reverse([2,3],[H,W],\"input\",\"output\"), \"flip_both\")\n \ndef make_rot_180():\n    return make_flip_both()\n \ndef make_rot_90_cw():\n    nodes  = [oh.make_node(\"Transpose\",[\"input\"],[\"t\"],perm=[0,1,3,2])]\n    nodes += _slice_reverse([3],[W],\"t\",\"output\")\n    return _make_model(nodes,\"rot90cw\")\n \ndef make_rot_90_ccw():\n    nodes  = [oh.make_node(\"Transpose\",[\"input\"],[\"t\"],perm=[0,1,3,2])]\n    nodes += _slice_reverse([2],[H],\"t\",\"output\")\n    return _make_model(nodes,\"rot90ccw\")\n \ndef make_anti_transpose():\n    nodes  = [oh.make_node(\"Transpose\",[\"input\"],[\"t\"],perm=[0,1,3,2])]\n    nodes += _slice_reverse([2,3],[H,W],\"t\",\"output\")\n    return _make_model(nodes,\"anti_transpose\")\n \ndef make_framed_rot180(h,w):\n    nodes  = _crop_to_content(\"input\",\"content\",h,w,\"0\")\n    nodes += _slice_reverse([2,3],[h,w],\"content\",\"rotated\",\"r\")\n    nodes += _pad_to_canvas(\"rotated\",\"output\",h,w,\"p\")\n    return _make_model(nodes,\"framed_rot180\")\n \ndef make_framed_flip_h(h,w):\n    nodes  = _crop_to_content(\"input\",\"content\",h,w,\"0\")\n    nodes += _slice_reverse([2],[h],\"content\",\"flipped\",\"r\")\n    nodes += _pad_to_canvas(\"flipped\",\"output\",h,w,\"p\")\n    return _make_model(nodes,\"framed_flip_h\")\n \ndef make_framed_flip_w(h,w):\n    nodes  = _crop_to_content(\"input\",\"content\",h,w,\"0\")\n    nodes += _slice_reverse([3],[w],\"content\",\"flipped\",\"r\")\n    nodes += _pad_to_canvas(\"flipped\",\"output\",h,w,\"p\")\n    return _make_model(nodes,\"framed_flip_w\")\n \ndef make_framed_transpose(h,w):\n    nodes  = _crop_to_content(\"input\",\"content\",h,w,\"0\")\n    nodes += [oh.make_node(\"Transpose\",[\"content\"],[\"transposed\"],perm=[0,1,3,2])]\n    nodes += _pad_to_canvas(\"transposed\",\"output\",w,h,\"p\")\n    return _make_model(nodes,\"framed_transpose\")\n \ndef make_framed_rot_90_cw(h,w):\n    nodes  = _crop_to_content(\"input\",\"content\",h,w,\"0\")\n    nodes += [oh.make_node(\"Transpose\",[\"content\"],[\"t\"],perm=[0,1,3,2])]\n    nodes += _slice_reverse([3],[h],\"t\",\"rotated\",\"r\")\n    nodes += _pad_to_canvas(\"rotated\",\"output\",w,h,\"p\")\n    return _make_model(nodes,\"framed_rot90cw\")\n \ndef make_framed_rot_90_ccw(h,w):\n    nodes  = _crop_to_content(\"input\",\"content\",h,w,\"0\")\n    nodes += [oh.make_node(\"Transpose\",[\"content\"],[\"t\"],perm=[0,1,3,2])]\n    nodes += _slice_reverse([2],[w],\"t\",\"rotated\",\"r\")\n    nodes += _pad_to_canvas(\"rotated\",\"output\",w,h,\"p\")\n    return _make_model(nodes,\"framed_rot90ccw\")\n \ndef make_color_remap_gather(color_map):\n    inv = {d:s for s,d in color_map.items()}\n    idx  = np.arange(C, dtype=np.int64)\n    mask = np.ones(C, dtype=np.float32)\n    src_gone = {s for s,d in color_map.items() if s!=d}\n    for d in range(C):\n        if d in inv:        idx[d] = inv[d]\n        elif d in src_gone: idx[d] = 0; mask[d] = 0.0\n        else:               idx[d] = d\n    gi    = _const(\"gi\", idx)\n    gnode = oh.make_node(\"Gather\",[\"input\",\"gi\"],[\"gathered\" if mask.min()<1 else \"output\"],axis=1)\n    if mask.min() == 1.0:\n        return _make_model([gi,gnode],\"color_remap\")\n    mk  = _const(\"cm\",mask.reshape(1,C,1,1))\n    mul = oh.make_node(\"Mul\",[\"gathered\",\"cm\"],[\"output\"])\n    return _make_model([gi,gnode,mk,mul],\"color_remap_masked\")\n \ndef make_crop(r0,c0,oh_,ow_):\n    nodes = [\n        _const(\"cs\",np.asarray([r0,c0],dtype=np.int64)),\n        _const(\"ce\",np.asarray([r0+oh_,c0+ow_],dtype=np.int64)),\n        _const(\"ca\",np.asarray([2,3],dtype=np.int64)),\n        oh.make_node(\"Slice\",[\"input\",\"cs\",\"ce\",\"ca\"],[\"cropped\"]),\n    ]\n    nodes += _pad_to_canvas(\"cropped\",\"output\",oh_,ow_,\"p\")\n    return _make_model(nodes,\"crop_net\")\n \ndef make_translation(dr,dc):\n    sr0=max(0,-dr); sr1=min(H,H-dr)\n    sc0=max(0,-dc); sc1=min(W,W-dc)\n    dr0=max(0,dr);  dc0=max(0,dc)\n    rh=sr1-sr0; rw=sc1-sc0\n    if rh<=0 or rw<=0: return None\n    pads = np.asarray([0,0,dr0,dc0,0,0,H-dr0-rh,W-dc0-rw],dtype=np.int64)\n    nodes = [\n        _const(\"ts\",np.asarray([sr0,sc0],dtype=np.int64)),\n        _const(\"te\",np.asarray([sr1,sc1],dtype=np.int64)),\n        _const(\"ta\",np.asarray([2,3],dtype=np.int64)),\n        oh.make_node(\"Slice\",[\"input\",\"ts\",\"te\",\"ta\"],[\"sliced\"]),\n        _const(\"pp\",pads),\n        oh.make_node(\"Pad\",[\"sliced\",\"pp\"],[\"output\"],mode=\"constant\"),\n    ]\n    return _make_model(nodes,\"translate_net\")\n \ndef make_framed_translation(gh,gw,dr,dc):\n    sr0=max(0,-dr); sr1=min(gh,gh-dr)\n    sc0=max(0,-dc); sc1=min(gw,gw-dc)\n    dr0=max(0,dr);  dc0=max(0,dc)\n    rh=sr1-sr0; rw=sc1-sc0\n    if rh<=0 or rw<=0: return None\n    pads = np.asarray([0,0,dr0,dc0,0,0,H-dr0-rh,W-dc0-rw],dtype=np.int64)\n    nodes = [\n        _const(\"fts\",np.asarray([sr0,sc0],dtype=np.int64)),\n        _const(\"fte\",np.asarray([sr1,sc1],dtype=np.int64)),\n        _const(\"fta\",np.asarray([2,3],dtype=np.int64)),\n        oh.make_node(\"Slice\",[\"input\",\"fts\",\"fte\",\"fta\"],[\"fsliced\"]),\n        _const(\"fpp\",pads),\n        oh.make_node(\"Pad\",[\"fsliced\",\"fpp\"],[\"output\"],mode=\"constant\"),\n    ]\n    return _make_model(nodes,\"framed_translate\")\n \ndef make_upscale(f,in_h,in_w):\n    nodes  = _crop_to_content(\"input\",\"content\",in_h,in_w,\"0\")\n    nodes += [\n        _const(\"rsz_roi\",    np.asarray([],dtype=np.float32)),\n        _const(\"rsz_scales\", np.asarray([],dtype=np.float32)),\n        _const(\"rsz_sizes\",  np.asarray([1,C,in_h*f,in_w*f],dtype=np.int64)),\n        oh.make_node(\"Resize\",[\"content\",\"rsz_roi\",\"rsz_scales\",\"rsz_sizes\"],[\"upscaled\"],\n                     mode=\"nearest\", coordinate_transformation_mode=\"asymmetric\",\n                     nearest_mode=\"floor\"),\n    ]\n    nodes += _pad_to_canvas(\"upscaled\",\"output\",in_h*f,in_w*f,\"p\")\n    return _make_model(nodes,\"upscale_net\")\n \ndef make_downscale(f,in_h,in_w):\n    out_h=in_h//f; out_w=in_w//f\n    nodes = [\n        _const(\"ds_s\",np.asarray([0,0],dtype=np.int64)),\n        _const(\"ds_e\",np.asarray([in_h,in_w],dtype=np.int64)),\n        _const(\"ds_a\",np.asarray([2,3],dtype=np.int64)),\n        _const(\"ds_p\",np.asarray([f,f],dtype=np.int64)),\n        oh.make_node(\"Slice\",[\"input\",\"ds_s\",\"ds_e\",\"ds_a\",\"ds_p\"],[\"downsampled\"]),\n    ]\n    nodes += _pad_to_canvas(\"downsampled\",\"output\",out_h,out_w,\"p\")\n    return _make_model(nodes,\"downscale_net\")\n \ndef make_tile(tr,tc,in_h,in_w):\n    nodes  = _crop_to_content(\"input\",\"content\",in_h,in_w,\"0\")\n    nodes += [\n        _const(\"tile_r\",np.asarray([1,1,tr,tc],dtype=np.int64)),\n        oh.make_node(\"Tile\",[\"content\",\"tile_r\"],[\"tiled\"]),\n    ]\n    nodes += _pad_to_canvas(\"tiled\",\"output\",in_h*tr,in_w*tc,\"p\")\n    return _make_model(nodes,\"tile_net\")\n \ndef make_concat_flip_w(in_h,in_w):\n    nodes  = _crop_to_content(\"input\",\"content\",in_h,in_w,\"0\")\n    nodes += _slice_reverse([3],[in_w],\"content\",\"flipped\",\"fw\")\n    nodes += [oh.make_node(\"Concat\",[\"content\",\"flipped\"],[\"concated\"],axis=3)]\n    nodes += _pad_to_canvas(\"concated\",\"output\",in_h,in_w*2,\"p\")\n    return _make_model(nodes,\"concat_flip_w\")\n \ndef make_concat_flip_h(in_h,in_w):\n    nodes  = _crop_to_content(\"input\",\"content\",in_h,in_w,\"0\")\n    nodes += _slice_reverse([2],[in_h],\"content\",\"flipped\",\"fh\")\n    nodes += [oh.make_node(\"Concat\",[\"content\",\"flipped\"],[\"concated\"],axis=2)]\n    nodes += _pad_to_canvas(\"concated\",\"output\",in_h*2,in_w,\"p\")\n    return _make_model(nodes,\"concat_flip_h\")\n \ndef make_concat_rot180_w(in_h,in_w):\n    nodes  = _crop_to_content(\"input\",\"content\",in_h,in_w,\"0\")\n    nodes += _slice_reverse([2,3],[in_h,in_w],\"content\",\"rotated\",\"r\")\n    nodes += [oh.make_node(\"Concat\",[\"content\",\"rotated\"],[\"concated\"],axis=3)]\n    nodes += _pad_to_canvas(\"concated\",\"output\",in_h,in_w*2,\"p\")\n    return _make_model(nodes,\"concat_rot180_w\")\n \ndef make_quadrant_mirror(in_h,in_w):\n    nodes  = _crop_to_content(\"input\",\"content\",in_h,in_w,\"0\")\n    nodes += _slice_reverse([3],[in_w],\"content\",\"fw\",\"fw\")\n    nodes += [oh.make_node(\"Concat\",[\"content\",\"fw\"],[\"top_row\"],axis=3)]\n    nodes += _slice_reverse([2],[in_h],\"content\",\"fh\",\"fh\")\n    nodes += _slice_reverse([2,3],[in_h,in_w],\"content\",\"fr\",\"fr\")\n    nodes += [oh.make_node(\"Concat\",[\"fh\",\"fr\"],[\"bot_row\"],axis=3)]\n    nodes += [oh.make_node(\"Concat\",[\"top_row\",\"bot_row\"],[\"full\"],axis=2)]\n    nodes += _pad_to_canvas(\"full\",\"output\",in_h*2,in_w*2,\"p\")\n    return _make_model(nodes,\"quadrant_mirror\")\n \ndef make_row_broadcast(in_h,in_w,row_idx):\n    nodes = [\n        _const(\"rb_s\",np.asarray([row_idx],dtype=np.int64)),\n        _const(\"rb_e\",np.asarray([row_idx+1],dtype=np.int64)),\n        _const(\"rb_a\",np.asarray([2],dtype=np.int64)),\n        oh.make_node(\"Slice\",[\"input\",\"rb_s\",\"rb_e\",\"rb_a\"],[\"one_row\"]),\n        _const(\"rb_r\",np.asarray([1,1,in_h,1],dtype=np.int64)),\n        oh.make_node(\"Tile\",[\"one_row\",\"rb_r\"],[\"tiled\"]),\n        _const(\"rb_cs\",np.asarray([0,0],dtype=np.int64)),\n        _const(\"rb_ce\",np.asarray([in_h,in_w],dtype=np.int64)),\n        _const(\"rb_ca\",np.asarray([2,3],dtype=np.int64)),\n        oh.make_node(\"Slice\",[\"tiled\",\"rb_cs\",\"rb_ce\",\"rb_ca\"],[\"cropped\"]),\n    ]\n    nodes += _pad_to_canvas(\"cropped\",\"output\",in_h,in_w,\"p\")\n    return _make_model(nodes,\"row_broadcast\")\n \ndef make_col_broadcast(in_h,in_w,col_idx):\n    nodes = [\n        _const(\"cb_s\",np.asarray([col_idx],dtype=np.int64)),\n        _const(\"cb_e\",np.asarray([col_idx+1],dtype=np.int64)),\n        _const(\"cb_a\",np.asarray([3],dtype=np.int64)),\n        oh.make_node(\"Slice\",[\"input\",\"cb_s\",\"cb_e\",\"cb_a\"],[\"one_col\"]),\n        _const(\"cb_r\",np.asarray([1,1,1,in_w],dtype=np.int64)),\n        oh.make_node(\"Tile\",[\"one_col\",\"cb_r\"],[\"tiled\"]),\n        _const(\"cb_cs\",np.asarray([0,0],dtype=np.int64)),\n        _const(\"cb_ce\",np.asarray([in_h,in_w],dtype=np.int64)),\n        _const(\"cb_ca\",np.asarray([2,3],dtype=np.int64)),\n        oh.make_node(\"Slice\",[\"tiled\",\"cb_cs\",\"cb_ce\",\"cb_ca\"],[\"cropped\"]),\n    ]\n    nodes += _pad_to_canvas(\"cropped\",\"output\",in_h,in_w,\"p\")\n    return _make_model(nodes,\"col_broadcast\")\n \ndef make_const(output_grid):\n    og = np.asarray(output_grid, dtype=np.int32)\n    oh_, ow_ = og.shape\n    padded = np.zeros((1,C,H,W), dtype=np.float32)\n    for r in range(oh_):\n        for c_idx in range(ow_):\n            v = int(og[r,c_idx])\n            if 0 <= v < C:\n                padded[0,v,r,c_idx] = 1.0\n    nodes = [_const(\"K\",padded), oh.make_node(\"Identity\",[\"K\"],[\"output\"])]\n    return _make_model(nodes,\"const_net\")\n \ndef make_pad_with_border(grid_h,grid_w,border,fill_color):\n    oh_ = grid_h + 2*border; ow_ = grid_w + 2*border\n    if oh_>H or ow_>W: return None\n    nodes  = _crop_to_content(\"input\",\"content\",grid_h,grid_w,\"pb0\")\n    pb_pads = np.asarray([0,0,border,border,0,0,border,border],dtype=np.int64)\n    nodes += [\n        _const(\"pb_pads\",pb_pads),\n        oh.make_node(\"Pad\",[\"content\",\"pb_pads\"],[\"padded\"],mode=\"constant\"),\n    ]\n    mask = np.zeros((1,C,oh_,ow_),dtype=np.float32)\n    if 0 <= fill_color < C:\n        mask[0,fill_color,:border,:] = 1.0; mask[0,fill_color,-border:,:] = 1.0\n        mask[0,fill_color,:,:border] = 1.0; mask[0,fill_color,:,-border:] = 1.0\n    nodes += [\n        _const(\"pb_mask\",mask),\n        oh.make_node(\"Add\",[\"padded\",\"pb_mask\"],[\"bordered\"]),\n    ]\n    nodes += _pad_to_canvas(\"bordered\",\"output\",oh_,ow_,\"pbf\")\n    return _make_model(nodes,\"pad_border\")\n \ndef make_crop_then_color(r0,c0,oh_,ow_,color_map):\n    nodes = [\n        _const(\"ctc_s\",np.asarray([r0,c0],dtype=np.int64)),\n        _const(\"ctc_e\",np.asarray([r0+oh_,c0+ow_],dtype=np.int64)),\n        _const(\"ctc_a\",np.asarray([2,3],dtype=np.int64)),\n        oh.make_node(\"Slice\",[\"input\",\"ctc_s\",\"ctc_e\",\"ctc_a\"],[\"cropped\"]),\n    ]\n    inv = {d:s for s,d in color_map.items()}\n    idx  = np.arange(C,dtype=np.int64)\n    mask = np.ones(C,dtype=np.float32)\n    src_gone = {s for s,d in color_map.items() if s!=d}\n    for d in range(C):\n        if d in inv:        idx[d]=inv[d]\n        elif d in src_gone: idx[d]=0; mask[d]=0.0\n        else:               idx[d]=d\n    gi    = _const(\"gi_ctc\",idx)\n    gnode = oh.make_node(\"Gather\",[\"cropped\",\"gi_ctc\"],[\"colored\" if mask.min()<1 else \"colmid\"],axis=1)\n    if mask.min()==1.0:\n        gnode = oh.make_node(\"Gather\",[\"cropped\",\"gi_ctc\"],[\"colmid\"],axis=1)\n        nodes += [gi,gnode]\n    else:\n        mk  = _const(\"cm_ctc\",mask.reshape(1,C,1,1))\n        mul = oh.make_node(\"Mul\",[\"colmid\",\"cm_ctc\"],[\"colored\"])\n        nodes += [gi,gnode,mk,mul]\n    # final name must be \"colored\" for pad to work\n    color_out = \"colmid\" if mask.min()==1.0 else \"colored\"\n    nodes += _pad_to_canvas(color_out,\"output\",oh_,ow_,\"ctcp\")\n    return _make_model(nodes,\"crop_color\")\n \ndef make_transform_plus_color(base_fn, color_map):\n    base       = base_fn()\n    base_nodes = [copy.deepcopy(n) for n in base.graph.node]\n    for node in base_nodes:\n        for i,o in enumerate(node.output):\n            if o==\"output\": node.output[i]=\"mid\"\n    inv = {d:s for s,d in color_map.items()}\n    idx  = np.arange(C,dtype=np.int64)\n    mask = np.ones(C,dtype=np.float32)\n    src_gone = {s for s,d in color_map.items() if s!=d}\n    for d in range(C):\n        if d in inv:        idx[d]=inv[d]\n        elif d in src_gone: idx[d]=0; mask[d]=0.0\n        else:               idx[d]=d\n    gi = _const(\"gi2\",idx)\n    if mask.min()==1.0:\n        gnode = oh.make_node(\"Gather\",[\"mid\",\"gi2\"],[\"output\"],axis=1)\n        return _make_model(base_nodes+[gi,gnode],\"xform_color\")\n    gnode = oh.make_node(\"Gather\",[\"mid\",\"gi2\"],[\"gathered2\"],axis=1)\n    mk  = _const(\"cm2\",mask.reshape(1,C,1,1))\n    mul = oh.make_node(\"Mul\",[\"gathered2\",\"cm2\"],[\"output\"])\n    return _make_model(base_nodes+[gi,gnode,mk,mul],\"xform_color_masked\")\n \ndef make_self_similar_tile(in_h, in_w):\n    out_h = in_h * in_h; out_w = in_w * in_w\n    if out_h > H or out_w > W: return None\n    nodes  = _crop_to_content(\"input\",\"content\",in_h,in_w,\"sst0\")\n    nodes += [\n        _const(\"sst_cs0\", np.asarray([0], dtype=np.int64)),\n        _const(\"sst_ce0\", np.asarray([1], dtype=np.int64)),\n        _const(\"sst_ca0\", np.asarray([1], dtype=np.int64)),\n        oh.make_node(\"Slice\",[\"content\",\"sst_cs0\",\"sst_ce0\",\"sst_ca0\"],[\"bg_ch\"]),\n        _const(\"sst_one\", np.ones((1,1,1,1), dtype=np.float32)),\n        oh.make_node(\"Sub\",[\"sst_one\",\"bg_ch\"],[\"presence\"]),\n    ]\n    nodes += [\n        _const(\"sst_roi\",    np.asarray([], dtype=np.float32)),\n        _const(\"sst_scales\", np.asarray([], dtype=np.float32)),\n        _const(\"sst_sizes\",  np.asarray([1,1,out_h,out_w], dtype=np.int64)),\n        oh.make_node(\"Resize\",[\"presence\",\"sst_roi\",\"sst_scales\",\"sst_sizes\"],[\"pres_up\"],\n                     mode=\"nearest\", coordinate_transformation_mode=\"asymmetric\",\n                     nearest_mode=\"floor\"),\n    ]\n    nodes += [\n        _const(\"sst_reps\", np.asarray([1,1,in_h,in_w], dtype=np.int64)),\n        oh.make_node(\"Tile\",[\"content\",\"sst_reps\"],[\"tiled\"]),\n        oh.make_node(\"Mul\",[\"tiled\",\"pres_up\"],[\"masked\"]),\n    ]\n    nodes += _pad_to_canvas(\"masked\",\"output\",out_h,out_w,\"sstp\")\n    return _make_model(nodes,\"self_similar_tile\")\n \n \n# --- Analytic Conv ONNX Builders ---\n \ndef make_conv_masked(W, B=None, dilation=1):\n    k = W.shape[2]; pad = dilation * (k // 2)\n    inits = [_ft(\"W\", W)]\n    if B is not None:\n        inits.append(_ft(\"B\", B))\n        conv = oh.make_node(\"Conv\", [\"input\",\"W\",\"B\"], [\"conv_out\"],\n                            kernel_shape=[k,k], pads=[pad]*4, dilations=[dilation,dilation])\n    else:\n        conv = oh.make_node(\"Conv\", [\"input\",\"W\"], [\"conv_out\"],\n                            kernel_shape=[k,k], pads=[pad]*4, dilations=[dilation,dilation])\n    # ReduceMax with axes as attribute (opset-17 correct form)\n    rm   = oh.make_node(\"ReduceMax\", [\"input\"], [\"mask\"], axes=[1], keepdims=1)\n    mul  = oh.make_node(\"Mul\", [\"conv_out\",\"mask\"], [\"output\"])\n    return _make_model_with_inits([conv, rm, mul], inits, \"conv_mas