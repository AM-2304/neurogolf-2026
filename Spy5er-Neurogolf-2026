atenate([ig,np.fliplr(ig)],axis=1)\n        bot=np.concatenate([np.flipud(ig),np.rot90(ig,2)],axis=1)\n        if not np.array_equal(np.concatenate([top,bot],axis=0),og): return None\n    return True\n \ndef detect_row_broadcast(pairs):\n    if not all_same_io_shape(pairs): return None\n    chosen=None\n    for p in pairs:\n        ig=np.asarray(p[\"input\"]); og=np.asarray(p[\"output\"]); ih,_=ig.shape\n        matched=next((r for r in range(ih) if np.all(og==ig[r,:])),None)\n        if matched is None: return None\n        if chosen is None: chosen=matched\n        elif chosen!=matched: return None\n    return chosen\n \ndef detect_col_broadcast(pairs):\n    if not all_same_io_shape(pairs): return None\n    chosen=None\n    for p in pairs:\n        ig=np.asarray(p[\"input\"]); og=np.asarray(p[\"output\"]); _,iw=ig.shape\n        matched=next((c_idx for c_idx in range(iw) if np.all(og==ig[:,c_idx:c_idx+1])),None)\n        if matched is None: return None\n        if chosen is None: chosen=matched\n        elif chosen!=matched: return None\n    return chosen\n \ndef detect_crop_plus_color(pairs):\n    if not pairs: return None\n    fst_in=np.asarray(pairs[0][\"input\"]); fst_out=np.asarray(pairs[0][\"output\"])\n    oh_,ow_=fst_out.shape; ih,iw=fst_in.shape\n    if oh_>ih or ow_>iw: return None\n    for r0 in range(ih-oh_+1):\n        for c0 in range(iw-ow_+1):\n            cmap={}; valid=True\n            for p in pairs:\n                ig=np.asarray(p[\"input\"]); og=np.asarray(p[\"output\"])\n                if og.shape!=(oh_,ow_): valid=False; break\n                if r0+oh_>ig.shape[0] or c0+ow_>ig.shape[1]: valid=False; break\n                region=ig[r0:r0+oh_,c0:c0+ow_]\n                for a,b in zip(region.flatten().tolist(),og.flatten().tolist()):\n                    a,b=int(a),int(b)\n                    if a in cmap and cmap[a]!=b: valid=False; break\n                    cmap[a]=b\n                if not valid: break\n            if not valid: continue\n            if all(k==v for k,v in cmap.items()): continue\n            ok=True\n            for p in pairs:\n                ig=np.asarray(p[\"input\"]); og=np.asarray(p[\"output\"])\n                region=ig[r0:r0+oh_,c0:c0+ow_]\n                mapped=region.copy()\n                for k,v in cmap.items(): mapped[region==k]=v\n                if not np.array_equal(mapped,og): ok=False; break\n            if ok: return (r0,c0,oh_,ow_,cmap)\n    return None\n \ndef detect_border_add(pairs):\n    if not pairs: return None\n    fst_in=np.asarray(pairs[0][\"input\"]); fst_out=np.asarray(pairs[0][\"output\"])\n    ih,iw=fst_in.shape; oh_,ow_=fst_out.shape\n    if (oh_-ih)!=(ow_-iw): return None\n    delta=oh_-ih\n    if delta<=0 or delta%2!=0: return None\n    b=delta//2\n    if not np.array_equal(fst_out[b:b+ih,b:b+iw],fst_in): return None\n    vals=(set(fst_out[:b,:].flatten().tolist())|set(fst_out[-b:,:].flatten().tolist())|\n          set(fst_out[:,:b].flatten().tolist())|set(fst_out[:,-b:].flatten().tolist()))\n    if len(vals)!=1: return None\n    fill=int(vals.pop())\n    for p in pairs[1:]:\n        ig=np.asarray(p[\"input\"]); og=np.asarray(p[\"output\"]); ih2,iw2=ig.shape\n        if og.shape!=(ih2+2*b,iw2+2*b): return None\n        if not np.array_equal(og[b:b+ih2,b:b+iw2],ig): return None\n    return (b,fill)\n \ndef detect_rotation_plus_color(pairs):\n    for rot_label,k in [(\"180\",2),(\"90cw\",-1),(\"90ccw\",1)]:\n        mapping={}; ok=True\n        for p in pairs:\n            ig=np.asarray(p[\"input\"]); og=np.asarray(p[\"output\"])\n            r=np.rot90(ig,k)\n            if r.shape!=og.shape: ok=False; break\n            for a,b in zip(r.flatten().tolist(),og.flatten().tolist()):\n                a,b=int(a),int(b)\n                if a in mapping and mapping[a]!=b: ok=False; break\n                mapping[a]=b\n            if not ok: break\n        if ok and any(k2!=v for k2,v in mapping.items()): return (rot_label,mapping)\n    return None\n \ndef detect_flip_plus_color(pairs):\n    for name,fn in [(\"h\",np.flipud),(\"w\",np.fliplr),(\"both\",lambda a:np.flipud(np.fliplr(a)))]:\n        mapping={}; ok=True\n        for p in pairs:\n            ig=np.asarray(p[\"input\"]); og=np.asarray(p[\"output\"])\n            f=fn(ig)\n            if f.shape!=og.shape: ok=False; break\n            for a,b in zip(f.flatten().tolist(),og.flatten().tolist()):\n                a,b=int(a),int(b)\n                if a in mapping and mapping[a]!=b: ok=False; break\n                mapping[a]=b\n            if not ok: break\n        if ok and any(k2!=v for k2,v in mapping.items()): return (name,mapping)\n    return None\n \ndef detect_transpose_plus_color(pairs):\n    mapping={}\n    for p in pairs:\n        ig=np.asarray(p[\"input\"]); og=np.asarray(p[\"output\"])\n        if ig.T.shape!=og.shape: return None\n        for a,b in zip(ig.T.flatten().tolist(),og.flatten().tolist()):\n            a,b=int(a),int(b)\n            if a in mapping and mapping[a]!=b: return None\n            mapping[a]=b\n    if any(k!=v for k,v in mapping.items()): return mapping\n    return None\n \ndef detect_self_similar_tile(pairs):\n    for p in pairs:\n        ig=np.asarray(p[\"input\"]); og=np.asarray(p[\"output\"])\n        ih,iw=ig.shape; oh_,ow_=og.shape\n        if oh_!=ih*ih or ow_!=iw*iw: return None\n        if oh_>H or ow_>W: return None\n        for br in range(ih):\n            for bc in range(iw):\n                block=og[br*ih:(br+1)*ih, bc*iw:(bc+1)*iw]\n                if ig[br,bc]!=0:\n                    if not np.array_equal(block,ig): return None\n                else:\n                    if not np.all(block==0): return None\n    return True","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-23T20:27:56.293009Z","iopub.execute_input":"2026-04-23T20:27:56.293310Z","iopub.status.idle":"2026-04-23T20:27:56.341988Z","shell.execute_reply.started":"2026-04-23T20:27:56.293242Z","shell.execute_reply":"2026-04-23T20:27:56.341192Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# Analytic Solver (lstsq) + CNN Training","metadata":{}},{"cell_type":"code","source":"def extract_patches(inp, k, dilation=1):\n    c_in, h, w = inp.shape\n    pad = dilation * (k // 2)\n    inp_padded = np.pad(inp, ((0,0),(pad,pad),(pad,pad)), mode='constant')\n    patches = np.zeros((c_in * k * k, h, w), dtype=np.float32)\n    idx = 0\n    for ci in range(c_in):\n        for ki in range(k):\n            for kj in range(k):\n                si = ki * dilation; sj = kj * dilation\n                patches[idx] = inp_padded[ci, si:si+h, sj:sj+w]\n                idx += 1\n    return patches\n \n \ndef solve_conv_analytic(pairs, k, dilation=1, use_bias=True, use_mask=True):\n    feat_dim = C * k * k\n    all_X = []; all_Y = []\n    for p in pairs:\n        inp = grid_to_tensor(p[\"input\"])[0]; out = grid_to_tensor(p[\"output\"])[0]\n        inp_h=len(p[\"input\"]); inp_w=len(p[\"input\"][0])\n        out_h=len(p[\"output\"]); out_w=len(p[\"output\"][0])\n        if use_mask:\n            mask = np.max(inp, axis=0) > 0\n            if inp_h!=out_h or inp_w!=out_w:\n                mask = np.zeros((H,W), dtype=bool)\n                mask[:out_h,:out_w] = True\n        else:\n            mask = np.zeros((H,W), dtype=bool)\n            mask[:max(inp_h,out_h),:max(inp_w,out_w)] = True\n        patches = extract_patches(inp, k, dilation=dilation)\n        X_flat = patches[:,mask].T; Y_flat = out[:,mask].T\n        if use_bias:\n            X_flat = np.concatenate([X_flat, np.ones((X_flat.shape[0],1),dtype=np.float32)], axis=1)\n        all_X.append(X_flat); all_Y.append(Y_flat)\n    X = np.concatenate(all_X, axis=0); Y = np.concatenate(all_Y, axis=0)\n    if X.shape[0] < X.shape[1]: return None\n    try:\n        W_sol,_,_,_ = np.linalg.lstsq(X, Y, rcond=None)\n    except Exception:\n        return None\n    if np.max(np.abs(X @ W_sol - Y)) > 0.45: return None\n    W_sol = W_sol.T\n    if use_bias:\n        B = W_sol[:,-1].astype(np.float32)\n        W_conv = W_sol[:,:-1].reshape(C,C,k,k).astype(np.float32)\n    else:\n        B = None; W_conv = W_sol.reshape(C,C,k,k).astype(np.float32)\n    return W_conv, B\n \n \ndef solve_rcpool_analytic(pairs, k, use_max=True, use_bias=True):\n    all_X = []; all_Y = []\n    for p in pairs:\n        inp = grid_to_tensor(p[\"input\"])[0]; out = grid_to_tensor(p[\"output\"])[0]\n        mask = np.max(inp, axis=0) > 0\n        patches = extract_patches(inp, k, dilation=1)\n        row_pool = (np.max if use_max else np.mean)(inp, axis=2, keepdims=True)\n        col_pool = (np.max if use_max else np.mean)(inp, axis=1, keepdims=True)\n        features = np.concatenate([patches,\n                                   np.broadcast_to(row_pool,(C,H,W)),\n                                   np.broadcast_to(col_pool,(C,H,W))], axis=0)\n        X_flat = features[:,mask].T; Y_flat = out[:,mask].T\n        if use_bias:\n            X_flat = np.concatenate([X_flat, np.ones((X_flat.shape[0],1),dtype=np.float32)], axis=1)\n        all_X.append(X_flat); all_Y.append(Y_flat)\n    X = np.concatenate(all_X, axis=0); Y = np.concatenate(all_Y, axis=0)\n    if X.shape[0] < X.shape[1]: return None\n    try:\n        W_sol,_,_,_ = np.linalg.lstsq(X, Y, rcond=None)\n    except Exception:\n        return None\n    if np.max(np.abs(X @ W_sol - Y)) > 0.45: return None\n    W_sol = W_sol.T\n    local_size = C * k * k\n    Wl = W_sol[:,:local_size].reshape(C,C,k,k).astype(np.float32)\n    Wr = W_sol[:,local_size:local_size+C].reshape(C,C,1,1).astype(np.float32)\n    Wc = W_sol[:,local_size+C:local_size+2*C].reshape(C,C,1,1).astype(np.float32)\n    Br = W_sol[:,-1].astype(np.float32) if use_bias else np.zeros(C,dtype=np.float32)\n    return Wl, Wr, Br, Wc\n \n \ndef try_analytic_solvers(pairs, all_pairs, time_limit=15):\n    t0 = time.time()\n    conv_configs = [\n        (1,1,False,True),(1,1,True,True),(1,1,False,False),\n        (3,1,True,True),(3,1,False,True),(5,1,True,True),(7,1,True,True),\n        (9,1,True,True),(11,1,True,True),(3,2,True,True),(3,3,True,True),\n        (3,4,True,True),(3,5,True,True),(3,6,True,True),(5,2,True,True),(5,3,True,True),\n    ]\n    for k, dilation, use_bias, use_mask in conv_configs:\n        if time.time()-t0 > time_limit: break\n        try:\n            result = solve_conv_analytic(pairs, k, dilation, use_bias, use_mask)\n            if result is None: continue\n            W, B = result\n            if use_mask and use_bias:   model = make_conv_masked(W, B, dilation)\n            elif use_mask:              model = make_conv_masked(W, None, dilation)\n            elif not use_bias:          model = make_conv_no_mask(W, dilation)\n            else:                       continue\n            if not check_fits(model): continue\n            if not check_model_correct(model, all_pairs): continue\n            c = compute_cost(model)\n            lbl = f\"lstsq_k{k}\" + (f\"d{dilation}\" if dilation>1 else \"\") + \\\n                  (\"_b\" if use_bias else \"\") + (\"_m\" if use_mask else \"\")\n            return model, lbl, c\n        except Exception:\n            continue\n \n    for k, use_max, use_bias in [(1,True,True),(1,False,True),(3,True,True),(3,False,True)]:\n        if time.time()-t0 > time_limit: break\n        try:\n            result = solve_rcpool_analytic(pairs, k, use_max, use_bias)\n            if result is None: continue\n            Wl, Wr, Br, Wc = result\n            model = make_rcpool_model(Wl, Wr, Br, Wc, k, use_max)\n            if not check_fits(model): continue\n            if not check_model_correct(model, all_pairs): continue\n            c = compute_cost(model)\n            return model, f\"lstsq_rcpool_{'max' if use_max else 'mean'}_k{k}\", c\n        except Exception:\n            continue\n \n    return None, None, None\n \n \nclass MaskedCNN(nn.Module):\n    def __init__(self, hidden, k, n_layers=1, dilation=1):\n        super().__init__()\n        pad = dilation * (k // 2)\n        layers = []; in_c = C\n        for _ in range(n_layers):\n            layers.append(nn.Conv2d(in_c, hidden, k, padding=pad, dilation=dilation))\n            layers.append(nn.ReLU())\n            in_c = hidden\n        layers.append(nn.Conv2d(in_c, C, 1))\n        self.net = nn.Sequential(*layers)\n \n    def forward(self, x):\n        mask = x.max(dim=1, keepdim=True)[0]\n        return self.net(x) * mask\n \n \nclass FXOMaskedCNN(nn.Module):\n    def __init__(self, hidden, k, oa_mask, n_layers=1, dilation=1):\n        super().__init__()\n        pad = dilation * (k // 2)\n        layers = []; in_c = C\n        for _ in range(n_layers):\n            layers.append(nn.Conv2d(in_c, hidden, k, padding=pad, dilation=dilation))\n            layers.append(nn.ReLU())\n            in_c = hidden\n        layers.append(nn.Conv2d(in_c, C, 1))\n        self.net = nn.Sequential(*layers)\n        self.register_buffer('oa_mask', torch.from_numpy(oa_mask))\n \n    def forward(self, x):\n        return self.net(x) * self.oa_mask\n \n \ndef compute_oa_mask(pairs):\n    mask = np.zeros((1,1,H,W), dtype=np.float32)\n    for p in pairs:\n        og = np.asarray(p[\"output\"]); oh_, ow_ = og.shape\n        mask[0,0,:oh_,:ow_] = 1.0\n    return mask\n \n \ndef _export_and_fix_cnn(model) -> Optional[onnx.ModelProto]:\n    \"\"\"\n    Export a PyTorch model to ONNX, apply all fixups, run strict validation.\n    Returns a valid ONNX model or None.\n    \"\"\"\n    model.cpu(); model.eval()\n    buf = io.BytesIO()\n    dummy = torch.zeros(1, C, H, W)\n    try:\n        torch.onnx.export(\n            model, dummy, buf, opset_version=17,\n            input_names=[\"input\"], output_names=[\"output\"],\n            dynamic_axes=None,\n        )\n    except Exception:\n        return None\n \n    buf.seek(0)\n    try:\n        onnx_model = onnx.load(buf)\n        onnx_model.ir_version = IR_VERSION\n \n        # Fix opset-18-style ReduceMax/ReduceMean (axes as input tensor) emitted by PyTorch 2.x\n        onnx_model = _fix_reduce_ops_opset17(onnx_model)\n \n        # Annotate all intermediate tensor shapes\n        onnx_model = onnx.shape_inference.infer_shapes(onnx_model)\n \n        # Structural check — same as Kaggle's evaluator\n        onnx.checker.check_model(onnx_model)\n \n        # Static-shape check — competition requirement not enforced by onnx.checker\n        if not check_all_shapes_static(onnx_model):\n            return None\n \n        return onnx_model\n    except Exception:\n        return None\n \n \ndef train_cnn_model(pairs, hidden, k, n_layers=1, dilation=1, use_fxo=False,\n                    max_epochs=1500, n_restarts=1, patience=250, time_limit=45):\n    t_start = time.time()\n    X = np.concatenate([grid_to_tensor(p[\"input\"])  for p in pairs], axis=0)\n    Y = np.concatenate([grid_to_tensor(p[\"output\"]) for p in pairs], axis=0)\n    X_t = torch.from_numpy(X).to(DEVICE)\n    Y_t = torch.from_numpy(Y).to(DEVICE)\n \n    same_io = all(np.asarray(p[\"input\"]).shape == np.asarray(p[\"output\"]).shape for p in pairs)\n    oa_mask = None\n    if not same_io or use_fxo:\n        oa_mask = compute_oa_mask(pairs)\n \n    best_loss = float('inf'); best_state = None\n \n    for restart in range(n_restarts):\n        if time.time()-t_start > time_limit: break\n        model = (FXOMaskedCNN(hidden, k, oa_mask, n_layers, dilation)\n                 if oa_mask is not None\n                 else MaskedCNN(hidden, k, n_layers, dilation)).to(DEVICE)\n        lr = 1e-2 if restart==0 else 3e-3\n        optimizer = optim.Adam(model.parameters(), lr=lr)\n        scheduler = optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=max_epochs, eta_min=1e-5)\n        no_improve = 0\n        for epoch in range(max_epochs):\n            if epoch%100==0 and time.time()-t_start > time_limit: break\n            optimizer.zero_grad()\n            loss = nn.functional.mse_loss(model(X_t), Y_t)\n            loss.backward(); optimizer.step(); scheduler.step()\n            lv = loss.item()\n            if lv < best_loss:\n                best_loss = lv\n                best_state = {k_: v.cpu().clone() for k_,v in model.state_dict().items()}\n                no_improve = 0\n            else:\n                no_improve += 1\n            if lv < 1e-8 or no_improve > patience: break\n \n    if best_state is None: return None\n \n    model = (FXOMaskedCNN(hidden, k, oa_mask, n_layers, dilation)\n             if oa_mask is not None\n             else MaskedCNN(hidden, k, n_layers, dilation)).to(DEVICE)\n    model.load_state_dict(best_state); model.eval()\n \n    with torch.no_grad():\n        preds = model(X_t).cpu().numpy()\n    for i, p in enumerate(pairs):\n        og = np.asarray(p[\"output\"]); oh_, ow_ = og.shape\n        if tensor_to_grid(preds[i:i+1], oh_, ow_) != p[\"output\"]:\n            return None\n \n    return _export_and_fix_cnn(model)\n \n \ndef try_cnn_solvers(pairs, all_pairs, time_budget=60):\n    t_start = time.time()\n    cnn_configs = [\n        (8,3,1,1,\"cnn_k3_h8\"),(16,3,1,1,\"cnn_k3_h16\"),(8,5,1,1,\"cnn_k5_h8\"),\n        (8,3,2,1,\"cnn_k3_h8_2L\"),(16,5,1,1,\"cnn_k5_h16\"),(16,3,2,1,\"cnn_k3_h16_2L\"),\n        (8,7,1,1,\"cnn_k7_h8\"),(16,9,1,1,\"cnn_k9_h16\"),(32,3,2,1,\"cnn_k3_h32_2L\"),\n        (16,11,1,1,\"cnn_k11_h16\"),\n    ]\n    per_config_limit = max(15, time_budget // max(1, len(cnn_configs)))\n \n    for hidden, k, n_layers, dilation, name in cnn_configs:\n        if time.time()-t_start > time_budget: break\n        try:\n            onnx_model = train_cnn_model(pairs, hidden, k, n_layers, dilation,\n                                         max_epochs=1500, n_restarts=1, patience=250,\n                                         time_limit=per_config_limit)\n            if onnx_model is None: continue\n            if not check_fits(onnx_model): continue\n            if not check_model_correct(onnx_model, all_pairs): continue\n 